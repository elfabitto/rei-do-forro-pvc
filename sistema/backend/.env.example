# Copie para .env e ajuste. O .env nunca vai para o Git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL o projeto usa SQLite — suficiente para desenvolver.
#
# Supabase (região São Paulo). Use a porta 5432 (conexão direta) para rodar
# migrations e a 6543 (pooler) para a aplicação no ar:
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Capacidade da agenda (a ConfiguracaoAgenda no banco tem precedência)
AGENDA_CAPACIDADE_ENTREGA=3
AGENDA_CAPACIDADE_INSTALACAO=2
# 0=segunda … 6=domingo
AGENDA_DIAS_SEM_ATENDIMENTO=6
