# Copie para .env e ajuste. O .env nunca vai para o Git.
# Em produção (Render) estas variáveis ficam no painel do serviço — veja ../HOSPEDAGEM.md.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL o projeto usa SQLite — suficiente para desenvolver.
#
# Supabase: use o endereço do POOLER (aws-…pooler.supabase.com), não o db.<ref>.supabase.co
# (esse é só IPv6 e o Render não alcança).
#   porta 6543 (modo transaction) → a aplicação no ar
#   porta 5432 (modo session)     → migrations e comandos de carga
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_MIGRACAO=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# 0=segunda … 6=domingo
AGENDA_DIAS_SEM_ATENDIMENTO=6
